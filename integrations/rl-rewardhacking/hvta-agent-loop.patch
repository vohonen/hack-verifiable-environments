+    def _agent_loop_reward(self, batch: DataProto):
+        """Reward and per-sample columns from an agent-loop environment (hvta).
+
+        The loop set ``reward_score`` per episode, which verl placed at the last response
+        token of ``rm_scores``; that tensor is the reward. The episode record arrived as
+        ``hvta_*`` columns of ``non_tensor_batch`` (hvta.rl.metrics.record_to_columns).
+        Three aliases let the early stop read the batch unchanged:
+        ``response_test_func_arbitrary_pass`` and ``eq_hinted`` <- hack_triggered,
+        ``eq_correct`` <- honest_win, so its lambda is P(hack | not an honest win).
+        ``response`` is decoded here because the modified advantage estimator expects
+        that column from the reward manager.
+        """
+        nt = batch.non_tensor_batch
+        infos = {k: np.asarray(nt[k]).tolist() for k in nt.keys() if k.startswith("hvta_")}
+        if "hvta_hack_triggered" in nt:
+            hack = np.asarray(nt["hvta_hack_triggered"], dtype=float).tolist()
+            infos["response_test_func_arbitrary_pass"] = hack
+            infos["eq_hinted"] = hack
+            infos["eq_correct"] = np.asarray(nt["hvta_honest_win"], dtype=float).tolist()
+        infos["response"] = self.tokenizer.batch_decode(batch.batch["responses"], skip_special_tokens=True)
+        return batch.batch["rm_scores"], infos
+
+    def _agent_loop_metrics(self, batch: DataProto) -> dict:
+        """Per-batch counts from the ``hvta_*`` columns: ``detail/hvta/n_hack`` and friends,
+        plus one block per game. Same definitions as hvta's calibration table."""
+        nt = batch.non_tensor_batch
+        cols = {k: np.asarray(nt[k]).tolist() for k in nt.keys() if k.startswith("hvta_")}
+        if not cols:
+            return {}
+        from hvta.rl.metrics import aggregate_columns
+
+        return aggregate_columns(cols, prefix="detail/hvta")
+
